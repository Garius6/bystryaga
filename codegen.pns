импорт "синтаксис" как синтаксис
импорт "ос" как ос
импорт "ввод_вывод" как вв
импорт "фс" как фс
импорт "модули/codegen/генератор_json.pns" как json_gen
импорт "генератор_схемы.pns" как схема_gen

// codegen.pns — точка входа `pan task codegen <файл.pns> [-o <файл>]`
// для потребителей быстряги: обходит &Json/&Схема аннотации ОДНОГО
// файла (не дерева каталогов — ../codegen/main.pns это умеет, здесь
// нарочно уже, под конкретный сценарий быстряги: несколько структур
// тела/ответа запроса в одном небольшом файле, не большое дерево,
// которому нужны --check/--watch), собирает результат в один
// <файл>_gen.pns.
//
// &Json — переиспользует генератор ../codegen напрямую (codegen —
// pan-зависимость этого пакета, см. pan.toml). &Схема — свой, живёт
// рядом (генератор_схемы.pns) — путь импорта быстряги у каждого
// потребителя свой (глубина модули/), в отличие от std-модуля
// "кодирование/json", который &Json может импортировать по
// фиксированному пути из любого файла (см. её doc-комментарий).

функ реестр_генераторов() -> Соответствие(Строка, функ(Строка, Строка, Строка) -> Результат(Строка, Ошибка))
	пер р: Соответствие(Строка, функ(Строка, Строка, Строка) -> Результат(Строка, Ошибка)) = соответствие()
	р["Json"] = json_gen.генерировать
	р["Схема"] = схема_gen.генерировать
	р
конец

// Клауза импорта на каждый генератор — попадает в шапку выходного
// файла, только если этот генератор реально сработал хотя бы раз.
// &Схема здесь НЕТ — её генератор сам кладёт нужный импорт (путь до
// быстряги, обнаруженный вживую) первой строкой собственного тела, см.
// генератор_схемы.pns.
функ реестр_импортов() -> Соответствие(Строка, Строка)
	пер р: Соответствие(Строка, Строка) = соответствие()
	р["Json"] = "\"кодирование/json\" как json"
	р
конец

функ расширение_исходника(путь: Строка) -> Строка
	если строки_заканчивается_на_pns(путь) тогда
		".pns"
	иначе
		".ps"
	конец
конец

функ строки_заканчивается_на_pns(путь: Строка) -> Булево
	пер длина_суффикса = 4
	если длина(путь) < длина_суффикса тогда
		возврат ложь
	конец
	строки.срез(путь, длина(путь) - длина_суффикса, длина(путь)) == ".pns"
конец

функ без_расширения(путь: Строка) -> Строка
	пер расширение = расширение_исходника(путь)
	строки.срез(путь, 0, длина(путь) - длина(расширение))
конец

// Имя модуля для self-импорта сгенерированного файла — базовое имя
// (без каталога/расширения) исходного пути, тот же приём, что
// ../codegen/main.pns's имя_модуля_для_самоимпорта.
функ имя_модуля(путь: Строка) -> Строка
	пер части = строки.разбить(путь, "/")
	пер базовое = без_расширения(части.получить(части.длина() - 1, путь))
	базовое
конец

функ обработать_файл(путь: Строка) -> Результат(Строка, Ошибка)
	пер генераторы = реестр_генераторов()
	пер импорты_по_имени = реестр_импортов()

	пер структуры_результат = синтаксис.структуры(путь)
	если структуры_результат.ошибка() тогда
		возврат Результат.Неудача(структуры_результат.причина())
	конец
	пер структуры = структуры_результат.значение()

	пер тело = ""
	пер использованные: Соответствие(Строка, Булево) = соответствие()
	пер алиас_источника = имя_модуля(путь)

	для имя_структуры в структуры цикл
		пер аннотации_результат = синтаксис.аннотации(путь, имя_структуры)
		если аннотации_результат.ошибка() тогда
			возврат Результат.Неудача(аннотации_результат.причина())
		конец
		для имя_аннотации в аннотации_результат.значение() цикл
			если не генераторы.есть(имя_аннотации) тогда
				продолжить
			конец
			пер ген = генераторы.получить(имя_аннотации, json_gen.генерировать)
			пер результат = ген(путь, имя_структуры, алиас_источника)
			если результат.успех() тогда
				тело = "\(тело)\(результат.значение())"
				использованные[имя_аннотации] = истина
			иначе
				возврат Результат.Неудача(результат.причина())
			конец
		конец
	конец

	если тело == "" тогда
		возврат Результат.Успех("")
	конец

	пер шапка = "// Файл сгенерирован быстряга/codegen.pns из '\(путь)' — не редактировать вручную.\n"
	шапка = "\(шапка)импорт \"./\(алиас_источника)\" как \(алиас_источника)\n"
	для запись в использованные.записи() цикл
		пер импорт_строка = импорты_по_имени.получить(запись.0, "")
		если импорт_строка <> "" тогда
			шапка = "\(шапка)импорт \(импорт_строка)\n"
		конец
	конец
	// &Схема — РОВНО один импорт быстряги на файл, не на структуру
	// (путь обнаруживается вживую, см. генератор_схемы.pns's doc-
	// комментарий — не годится для реестр_импортов(), но и не должен
	// повторяться, если &Схема сработала на нескольких структурах).
	если использованные.есть("Схема") тогда
		пер путь_быстряги = схема_gen.найти_путь_быстряги(путь).ожидать("найти_путь_быстряги не удался")
		шапка = "\(шапка)импорт \"\(путь_быстряги)\" как быстряга\n"
	конец

	Результат.Успех("\(шапка)\n\(тело)")
конец

функ старт() -> Никогда
	пер аргс = ос.аргументы()
	если аргс.длина() < 1 тогда
		вв.строка("использование: pan task codegen <файл.pns> [-o <файл>]")
		ос.завершить(1.0)
	конец
	пер путь = аргс.получить(0, "")
	если не фс.есть(путь) тогда
		вв.строка("быстряга/codegen: '\(путь)' не существует")
		ос.завершить(1.0)
	конец

	пер результат = обработать_файл(путь)
	если результат.ошибка() тогда
		вв.строка("быстряга/codegen: \(результат.причина().сообщение)")
		ос.завершить(1.0)
	конец
	пер тело = результат.значение()
	если тело == "" тогда
		вв.строка("быстряга/codegen: в '\(путь)' не найдено ни одной аннотации с зарегистрированным генератором (&Json/&Схема)")
		ос.завершить(1.0)
	конец

	если аргс.длина() >= 3 и аргс.получить(1, "") == "-o" тогда
		пер выходной_путь = аргс.получить(2, "")
		пер _ = фс.записать(выходной_путь, тело).ожидать("не удалось записать выходной файл")
	иначе
		вв.печать(тело)
	конец
	ос.завершить(0.0)
конец
