// авторизация.pns — готовый JWT bearer-token посредник поверх
// std/кодирование/jwt.pns (HS256, HMAC-SHA256 через builtin крипто.*).
// Часть быстряги (../быстряга.pns реэкспортирует этот файл целиком).

импорт "сеть/http" как http
импорт "кодирование/jwt" как jwt
импорт строки
импорт "приложение.pns" как приложение
импорт "валидация.pns" как валидация

// Фабрика посредника (не сам посредник) — секрет фиксируется один раз
// при регистрации, а не читается заново на каждый запрос.
/// Посредник: требует "Authorization: Bearer <JWT>", подписанный
/// секретом секрет (HS256, см. std/кодирование/jwt.pns — проверить()
/// сама отклоняет истёкший "exp"-claim). Неверный/отсутствующий/
/// просроченный токен — короткое замыкание в 401, обработчик не
/// вызывается. Сами claims здесь дальше НЕ передаются (Запрос —
/// нативный opaque-тип, panos не даёт дописать в него поле) — если
/// обработчику нужны claims, он сам вызывает jwt.проверить(секрет,
/// токен) ещё раз на своём конце (тот же принцип, что документация.pns
/// не хранит состояние между запросами).
экспорт функ jwt_посредник(секрет: Строка) -> приложение.Посредник
	функ(зпр: Запрос, дальше: приложение.Далее) -> http.ОтветСервера
		пер заголовок = зпр.заголовок("Authorization")
		если заголовок.пусто() тогда
			возврат валидация.ответ_ошибки(401, "отсутствует заголовок Authorization")
		конец
		пер значение = заголовок.получить("")
		если не строки.начинается_с(значение, "Bearer ") тогда
			возврат валидация.ответ_ошибки(401, "Authorization должен быть в форме 'Bearer <токен>'")
		конец
		пер токен = строки.срез(значение, 7, длина(значение))
		пер проверка = jwt.проверить(секрет, токен)
		если проверка.ошибка() тогда
			возврат валидация.ответ_ошибки(401, "невалидный токен: " + проверка.причина().сообщение)
		конец
		дальше(зпр)
	конец
конец
