// быстряга — типизированная надстройка над std/сеть/http.pns.
// Один файл, не несколько (валидация/приложение), НАМЕРЕННО: panos не
// поддерживает реэкспорт между модулями (нет barrel-паттерна,
// `импорт "путь" как алиас` даёт доступ ТОЛЬКО к содержимому этого
// одного файла) — тот же принцип, по которому сам std/сеть/http.pns
// держит клиент+сервер+роутер+статику в одном файле, а не в четырёх.

импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт строки

// Собственные ТелоJSON/ОтветJSON, СТРУКТУРНО идентичные json.ИзJSON/json.ВJSON
// (те же методы/сигнатуры), но НЕ псевдоним и НЕ прямая ссылка на них —
// намеренно. Причина: тайпчекер panos резолвит generic-bound метода
// (`[Тело: json.ИзJSON]`) на СОБСТВЕННЫЙ ЛОКАЛЬНЫЙ символ быстряги,
// представляющий "json.ИзJSON" В ЕЁ СОБСТВЕННОМ пространстве символов
// (тот же механизм, что у любой квалифицированной ссылки `модуль.Имя`)
// — при переносе МЕТОДА, объявленного в быстряге, в ТРЕТИЙ модуль
// (приложение, которое `импорт быстряга`), компилятору нужно сопоставить
// ЭТОТ локальный символ быстряги с ТЕМ ЖЕ bound'ом, увиденным СО
// СТОРОНЫ приложения — а приложение видит json.ИзJSON через СВОЙ
// собственный локальный символ, отличный от символа быстряги.
// Сопоставление раскрученного (двухходового) псевдонима через границу
// ДВУХ модулей — реальный, найденный вживую пробел в текущей
// реализации кросс-модульного generic-импорта (символ есть, факт
// импорта его как ИНТЕРФЕЙСА тоже есть, но нет промежуточной
// трассировки "локальный символ модуля Б для типа из модуля А" ->
// "тот же тип, увиденный из модуля В"). Прямая (одноходовая) ссылка —
// интерфейс, объявленный ПРЯМО в быстряге (как Валидируемое ниже) и
// использованный чужим модулем — уже подтверждена рабочей; поэтому
// решение здесь — объявить СВОИ интерфейсы, не полагаться на
// транзитивное разрешение чужих. Достаётся почти бесплатно: структура,
// уже реализующая json.ИзJSON/json.ВJSON (для прямого использования
// json.разобрать_в/сериализовать_из где-то ещё), реализует ЭТИ поверх —
// тот же метод, то же тело, второй `реализация`-блок.
/// Реализуйте на структуре тела запроса, чтобы получить авто-разбор
/// JSON — идентично по форме json.ИзJSON (см. doc-комментарий файла:
/// НЕ то же самое с точки зрения тайпчекера, реализуйте оба, если нужно
/// и то, и другое).
экспорт тип ТелоJSON = интерфейс
	функ заполнить_из_json(значение: json.Значение) -> Опция(Ошибка)
конец

/// Реализуйте на структуре ответа, чтобы получить авто-сериализацию —
/// идентично по форме json.ВJSON (см. doc-комментарий файла).
экспорт тип ОтветJSON = интерфейс
	функ в_json() -> json.Значение
конец

/// Реализуйте на структуре тела запроса, чтобы получить авто-валидацию
/// — отправить_пост/отправить_put/отправить_patch вызывают .проверить()
/// сразу после разбора JSON, до вызова обработчика. Структуре без
/// реальной валидации достаточно вернуть Опция.Нет() всегда.
экспорт тип Валидируемое = интерфейс
	функ проверить() -> Опция(Строка)
конец

/// Строит ОтветСервера со статусом статус и JSON-телом {"ошибка": сообщение}.
/// Используется и для 400 (синтаксическая ошибка JSON), и для 422
/// (провал .проверить()) — одна форма тела ошибки на оба случая.
экспорт функ ответ_ошибки(статус: Число, сообщение: Строка) -> http.ОтветСервера
	пер тело = json.объект(массив(("ошибка", json.Значение.Строка(сообщение))))
	http.ОтветСервера(статус, "application/json", json.сериализовать(тело))
конец

/// Оборачивает тело ответа явным HTTP-статусом — обработчики
/// типизированных маршрутов ВСЕГДА возвращают Отклик(О), не голый О
/// (panos статически типизирован, у функции один тип возврата — см.
/// spec.md FR-007).
экспорт тип Отклик[О] = структура
	статус: Число
	тело:   О
конец

/// Отклик(О) со статусом 200 — сокращение для самого частого случая.
экспорт функ ок[О](тело: О) -> Отклик(О)
	Отклик(200.0, тело)
конец

/// Метаданные одного зарегистрированного маршрута — источник для
/// документация() ниже (US2). Без детальной JSON Schema тела/ответа
/// (см. doc-комментарий документация() — деградация "путь+метод есть,
/// схемы нет" явно допустима, spec.md FR-010).
тип МетаданныеМаршрута = структура
	метод: Строка
	путь:  Строка
конец

// Далее/Middleware работают на низкоуровневом Запрос (не
// http.ЗапросМаршрута) — middleware оборачивает ВЕСЬ конвейер
// обработки, ВКЛЮЧАЯ сопоставление маршрута (см. http.Маршрутизатор.
// обработать(это, запрос: Запрос) -> ОтветСервера — именно эта
// сигнатура оборачивается в .запустить() ниже), а не только уже
// сматченный конкретный маршрут. Middleware вроде проверки
// авторизации по заголовку должен уметь коротко замкнуть запрос ДО
// того, как вообще известно, какой маршрут подошёл бы.

/// Продолжение цепочки middleware — вызовите, чтобы передать запрос
/// дальше (следующему middleware или, для последнего звена, самому
/// Маршрутизатору). НЕ вызывайте, чтобы коротко замкнуть цепочку
/// (например при отказе авторизации) — тогда middleware сам
/// формирует ОтветСервера.
экспорт тип Далее = функ(Запрос) -> http.ОтветСервера

экспорт тип Middleware = функ(Запрос, Далее) -> http.ОтветСервера

/// Типизированная надстройка над http.Маршрутизатор — регистрируйте
/// маршруты методами получить/отправить_пост/..., затем .запустить(порт).
экспорт тип Приложение = структура
	маршрутизатор:      http.Маршрутизатор
	маршруты_докс:      Массив(МетаданныеМаршрута)
	middleware_список:  Массив(Middleware)
	хуки_старта:        Массив(функ() -> Пусто)
	хуки_остановки:     Массив(функ() -> Пусто)
конец

/// Создаёт пустое Приложение.
экспорт функ приложение() -> Приложение
	Приложение(http.маршрутизатор(), массив(), массив(), массив(), массив())
конец

реализация Приложение
	/// Регистрирует обработчик GET-запросов без тела — Ответ должен
	/// реализовывать быстряга.ОтветJSON, сериализуется автоматически.
	функ получить[Ответ: ОтветJSON](это: Приложение, путь: Строка, обработчик: функ(http.ЗапросМаршрута) -> Ответ) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("GET", путь))
		это.маршрутизатор.получить(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			http.ОтветСервера(200.0, "application/json", json.сериализовать(обработчик(зм).в_json()))
		конец)
	конец

	/// Регистрирует обработчик DELETE-запросов без тела — симметрично получить.
	функ удалить[Ответ: ОтветJSON](это: Приложение, путь: Строка, обработчик: функ(http.ЗапросМаршрута) -> Ответ) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("DELETE", путь))
		это.маршрутизатор.удалить(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			http.ОтветСервера(200.0, "application/json", json.сериализовать(обработчик(зм).в_json()))
		конец)
	конец

	/// Регистрирует обработчик POST-запросов с типизированным телом —
	/// разбирает JSON в Тело (нулевое_тело — фабрика пустого инстанса,
	/// panos не умеет сконструировать generic-параметр "из ничего", см.
	/// research.md Вопрос 1), валидирует через Тело.проверить()
	/// (Валидируемое — обязательный bound, см. research.md Вопрос 3),
	/// сериализует Отклик(Ответ) в JSON-ответ.
	функ отправить_пост[Тело: ТелоJSON + Валидируемое, Ответ: ОтветJSON](
		это: Приложение,
		путь: Строка,
		нулевое_тело: функ() -> Тело,
		обработчик: функ(Тело) -> Отклик(Ответ)
	) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("POST", путь))
		это.маршрутизатор.отправить_пост(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			обработать_тело(зм, нулевое_тело, обработчик)
		конец)
	конец

	/// Регистрирует обработчик PUT-запросов с типизированным телом — симметрично отправить_пост.
	функ отправить_put[Тело: ТелоJSON + Валидируемое, Ответ: ОтветJSON](
		это: Приложение,
		путь: Строка,
		нулевое_тело: функ() -> Тело,
		обработчик: функ(Тело) -> Отклик(Ответ)
	) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("PUT", путь))
		это.маршрутизатор.отправить_put(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			обработать_тело(зм, нулевое_тело, обработчик)
		конец)
	конец

	/// Регистрирует обработчик PATCH-запросов с типизированным телом — симметрично отправить_пост.
	функ отправить_patch[Тело: ТелоJSON + Валидируемое, Ответ: ОтветJSON](
		это: Приложение,
		путь: Строка,
		нулевое_тело: функ() -> Тело,
		обработчик: функ(Тело) -> Отклик(Ответ)
	) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("PATCH", путь))
		это.маршрутизатор.отправить_patch(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			обработать_тело(зм, нулевое_тело, обработчик)
		конец)
	конец

	/// Регистрирует middleware — вызывается в порядке РЕГИСТРАЦИИ
	/// (первый зарегистрированный вызывается первым при каждом
	/// запросе, оборачивает все последующие).
	функ middleware(это: Приложение, м: Middleware) -> Пусто
		это.middleware_список.добавить(м)
	конец

	/// Регистрирует хук, вызываемый РОВНО один раз перед первым
	/// принятым запросом (до http.обслуживать внутри .запустить()).
	функ при_старте(это: Приложение, ф: функ() -> Пусто) -> Пусто
		это.хуки_старта.добавить(ф)
	конец

	/// Регистрирует хук, вызываемый после остановки сервера — на
	/// практике сегодня недостижим для нормального пути: http.
	/// обслуживать блокирующий и не возвращается при успехе (см. его
	/// doc-комментарий), так что хуки_остановки срабатывают только
	/// если .запустить() вернулась с ошибкой бинда порта (см. ниже).
	функ при_остановке(это: Приложение, ф: функ() -> Пусто) -> Пусто
		это.хуки_остановки.добавить(ф)
	конец

	/// Слушает порт и обслуживает запросы (см. http.обслуживать).
	/// Строит финальную цепочку сворачиванием middleware_список СПРАВА
	/// НАЛЕВО вокруг это.маршрутизатор.обработать — при вызове порядок
	/// РЕАЛЬНЫХ вызовов получается M1 -> M2 -> ... -> Маршрутизатор
	/// (первый зарегистрированный — самый внешний). хуки_старта
	/// вызываются ДО http.обслуживать; хуки_остановки — ПОСЛЕ (см.
	/// doc-комментарий .при_остановке про сегодняшнее ограничение —
	/// блокирующий http.обслуживать делает "после" недостижимым на
	/// успешном пути).
	функ запустить(это: Приложение, порт: Число, процессов: Число) -> Результат(Число, Ошибка)
		для хук в это.хуки_старта цикл
			хук()
		конец

		пер маршрутизатор = это.маршрутизатор
		пер финальный = функ(зпр: Запрос) -> http.ОтветСервера
			маршрутизатор.обработать(зпр)
		конец

		// Именованная функция-ссылка в качестве запасного значения
		// ломает вывод типов (research.md Вопрос 8) — лямбда-литерал
		// с той же сигнатурой работает корректно; сам этот путь
		// недостижим на практике (i всегда в границах).
		пер i: Целое = это.middleware_список.длина() - 1
		пока i >= 0 цикл
			пер текущий = это.middleware_список.получить(i, функ(зпр: Запрос, дальше: Далее) -> http.ОтветСервера дальше(зпр) конец)
			пер следующий = финальный
			финальный = функ(зпр: Запрос) -> http.ОтветСервера
				текущий(зпр, следующий)
			конец
			i = i - 1
		конец

		пер результат = http.обслуживать(порт, финальный, процессов)

		для хук в это.хуки_остановки цикл
			хук()
		конец
		результат
	конец
конец

// Общее тело POST/PUT/PATCH-обёртки — разбор JSON, валидация,
// сериализация ответа. Свободная generic-функция, а не метод: тут
// Тело/Ответ выводятся из аргументов вызывающих методов
// (нулевое_тело/обработчик) одинаково в обоих случаях, так что
// дублировать тело функции в отправить_пост/put/patch незачем.
функ обработать_тело[Тело: ТелоJSON + Валидируемое, Ответ: ОтветJSON](
	зм: http.ЗапросМаршрута,
	нулевое_тело: функ() -> Тело,
	обработчик: функ(Тело) -> Отклик(Ответ)
) -> http.ОтветСервера
	пер тело = нулевое_тело()
	пер результат_разбора = json.разобрать(зм.запрос.тело())
	если результат_разбора.ошибка() тогда
		возврат ответ_ошибки(400.0, результат_разбора.причина().сообщение)
	конец
	пер ошибка_заполнения = тело.заполнить_из_json(результат_разбора.значение())
	если ошибка_заполнения.есть() тогда
		возврат ответ_ошибки(400.0, ошибка_заполнения.получить(Ошибка("json", "")).сообщение)
	конец
	пер ошибка_валид = тело.проверить()
	если ошибка_валид.есть() тогда
		возврат ответ_ошибки(422.0, ошибка_валид.получить(""))
	конец
	пер отклик = обработчик(тело)
	http.ОтветСервера(отклик.статус, "application/json", json.сериализовать(отклик.тело.в_json()))
конец

// ==================== US2: OpenAPI / Swagger ====================
//
// /openapi.json и /docs НЕ авто-регистрируются самим Приложение —
// вызывающий код сам решает путь (обычно "/openapi.json"/"/docs", но
// не навязано), см. quickstart.md: `апи.маршрутизатор.получить(
// "/openapi.json", быстряга.документация(апи))`.

// Строит операцию OpenAPI для одного (метод, путь) без детальной
// схемы тела/ответа — минимальный валидный `responses`-блок. Схема
// тела/ответа через ОписаниеСхемы — намеренно не в этой версии (см.
// doc-комментарий документация() ниже, FR-010 явно допускает эту
// деградацию); добавляется отдельной *_со_схемой-регистрацией позже,
// без изменения формы уже сгенерированного документа для маршрутов
// без схемы.
функ операция_openapi() -> json.Значение
	json.объект(массив(
		("responses", json.объект(массив(
			("200", json.объект(массив(
				("description", json.Значение.Строка("OK"))
			)))
		)))
	))
конец

/// Строит OpenAPI 3.x документ из уже зарегистрированных маршрутов
/// Приложения (это.маршруты_докс) и возвращает http.ОбработчикМаршрута,
/// отдающий его как /openapi.json. Строится ОДИН РАЗ в момент вызова
/// документация(это) — вызывайте ПОСЛЕ регистрации всех обычных
/// маршрутов (получить/отправить_пост/...), иначе замыкание не увидит
/// маршруты, зарегистрированные позже (тот же принцип, что и у
/// http.Маршрутизатор — путь регистрируется явно вызывающим кодом).
экспорт функ документация(это: Приложение) -> http.ОбработчикМаршрута
	пер пути: Соответствие(Строка, json.Значение) = соответствие()
	для маршрут в это.маршруты_докс цикл
		пер метод_ключ = строки.нижний_регистр(маршрут.метод)
		пер операция = операция_openapi()
		пер существующее = пути.получить(маршрут.путь, json.объект(массив()))
		пер методы = выбор существующее
			Объект(м) -> м
			_ -> соответствие()
		конец
		методы[метод_ключ] = операция
		пути[маршрут.путь] = json.Значение.Объект(методы)
	конец
	пер документ = json.объект(массив(
		("openapi", json.Значение.Строка("3.0.0")),
		("info", json.объект(массив(
			("title", json.Значение.Строка("API")),
			("version", json.Значение.Строка("1.0.0"))
		))),
		("paths", json.Значение.Объект(пути))
	))
	пер тело = json.сериализовать(документ)
	функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		http.ОтветСервера(200.0, "application/json", тело)
	конец
конец

/// Возвращает http.ОбработчикМаршрута, отдающий минимальную HTML-страницу с
/// Swagger UI через CDN (без бандлинга JS в репозиторий, spec.md
/// US2) — указывает на /openapi.json по умолчанию (то же имя пути,
/// что quickstart.md регистрирует через документация() выше;
/// вызывающий код обязан зарегистрировать /openapi.json под ЭТИМ
/// именем, если использует swagger_ui() без параметров).
экспорт функ swagger_ui() -> http.ОбработчикМаршрута
	пер страница = "<!DOCTYPE html><html><head><title>API docs</title>" +
		"<link rel=\"stylesheet\" href=\"https://unpkg.com/swagger-ui-dist/swagger-ui.css\">" +
		"</head><body><div id=\"swagger-ui\"></div>" +
		"<script src=\"https://unpkg.com/swagger-ui-dist/swagger-ui-bundle.js\"></script>" +
		"<script>window.onload = function() { SwaggerUIBundle({ url: \"/openapi.json\", dom_id: \"#swagger-ui\" }) }</script>" +
		"</body></html>"
	функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
		http.ОтветСервера(200.0, "text/html", страница)
	конец
конец
