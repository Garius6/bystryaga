// test_приложение.pns — US1 e2e-тесты: реальный сокет (сервер в
// запусти-процессе + сеть.http_запрос с клиентской стороны того же
// теста), не in-memory вызов обработчика напрямую (см. plan.md
// "Тестовая стратегия"). "Обработчик не вызван" при 400/422 проверяется
// косвенно — через форму ответа (json.объект с ключом "ошибка", не
// Задача.в_json()'s "ид"/"текст") и статус, а не через отдельный
// счётчик: panos не допускает top-level мутируемое состояние
// (конст — единственная top-level форма), а счётчик, живущий ТОЛЬКО
// внутри запусти-спавненного серверного процесса, недоступен обратно
// вызывающему тесту.

импорт быстряга
импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт "тест" как т
импорт время
импорт строки

конст ПОРТ = 18080

// --- Фикстуры (T004) ---

тип ЗадачаВвод = структура
	текст: Строка
конец

реализация быстряга.ТелоJSON для ЗадачаВвод
	функ заполнить_из_json(это: ЗадачаВвод, значение: json.Значение) -> Опция(Ошибка)
		пер поле_текст = значение.поле("текст")
		если поле_текст.пусто() тогда
			возврат Опция.Есть(Ошибка("json", "ожидалось поле 'текст'"))
		конец
		это.текст = поле_текст.получить(json.Значение.Ноль).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ЗадачаВвод
	функ проверить(это: ЗадачаВвод) -> Опция(Строка)
		если длина(это.текст) == 0 тогда
			возврат Опция.Есть("текст не может быть пустым")
		конец
		Опция.Нет()
	конец
конец

тип Задача = структура
	ид:   Число
	текст: Строка
конец

реализация быстряга.ОтветJSON для Задача
	функ в_json(это: Задача) -> json.Значение
		json.объект(массив(
			("ид", json.Значение.Число(это.ид)),
			("текст", json.Значение.Строка(это.текст))
		))
	конец
конец

функ нулевая_задача_ввод() -> ЗадачаВвод
	ЗадачаВвод("")
конец

// --- Приложение под тестом ---

// Лямбды, не именованные функции-ссылки — см. research.md Вопрос 8:
// передача ИМЕНОВАННОЙ функции значением в generic-bound параметр
// метода ломает вывод типов (реальный, отдельный от Вопроса 6 баг,
// найден здесь), лямбда-литерал с той же сигнатурой работает корректно.
функ запустить_сервер() -> Пусто
	пер апи = быстряга.приложение()
	апи.отправить_пост(
		"/задачи",
		функ() -> ЗадачаВвод нулевая_задача_ввод() конец,
		функ(ввод: ЗадачаВвод) -> быстряга.Отклик(Задача)
			быстряга.Отклик(201, Задача(1.0, ввод.текст))
		конец
	)
	апи.получить("/задачи", функ(зм: http.ЗапросМаршрута) -> быстряга.Отклик(Задача)
		быстряга.Отклик(200, Задача(0.0, ""))
	конец)
	апи.запустить(ПОРТ, 1.0)
конец

функ старт() -> Пусто
	пер отчёт = т.новый_отчёт()
	запусти запустить_сервер()
	время.спать_мс(200.0)

	пер база = "http://127.0.0.1:" + строки.из_целого(ПОРТ)

	// T005 / Acceptance Scenario 1 / SC-001: валидное тело — обработчик
	// вызван, ответ корректный JSON с полями Задача.
	пер рез1 = http.отправить_пост(база + "/задачи", "{\"текст\": \"купить хлеб\"}")
	т.проверить(отчёт, не рез1.ошибка(), "T005: POST /задачи с валидным телом не упал транспортно")
	если не рез1.ошибка() тогда
		пер ответ1 = рез1.значение()
		т.равны(отчёт, ответ1.статус, 201, "T005/T008: статус 201 (явный через Отклик)")
		пер тело1 = json.разобрать(ответ1.тело)
		т.проверить(отчёт, не тело1.ошибка(), "T005: тело ответа — валидный JSON")
		если не тело1.ошибка() тогда
			пер поле_текст = тело1.значение().поле("текст")
			т.проверить(отчёт, поле_текст.есть(), "T005: ответ содержит поле 'текст' (реально дошёл до обработчика)")
		конец
	конец

	// T006 / Acceptance Scenario 2 / SC-002: синтаксически некорректный JSON.
	пер рез2 = http.отправить_пост(база + "/задачи", "{не json")
	т.проверить(отчёт, не рез2.ошибка(), "T006: POST с невалидным JSON не упал транспортно")
	если не рез2.ошибка() тогда
		пер ответ2 = рез2.значение()
		т.равны(отчёт, ответ2.статус, 400, "T006: статус 400 на синтаксическую ошибку JSON")
		пер тело2 = json.разобрать(ответ2.тело)
		если не тело2.ошибка() тогда
			т.проверить(отчёт, тело2.значение().поле("ошибка").есть(), "T006: тело — структура ошибки, не Задача (обработчик не вызван)")
		конец
	конец

	// T007 / Acceptance Scenario 3 / SC-003: пустой текст — провал валидации.
	пер рез3 = http.отправить_пост(база + "/задачи", "{\"текст\": \"\"}")
	т.проверить(отчёт, не рез3.ошибка(), "T007: POST с пустым текст не упал транспортно")
	если не рез3.ошибка() тогда
		пер ответ3 = рез3.значение()
		т.равны(отчёт, ответ3.статус, 422, "T007: статус 422 на провал валидации")
		пер тело3 = json.разобрать(ответ3.тело)
		если не тело3.ошибка() тогда
			т.проверить(отчёт, тело3.значение().поле("ошибка").есть(), "T007: тело — структура ошибки, не Задача (обработчик не вызван)")
		конец
	конец

	// T009 / Acceptance Scenario 5: GET без тела — шаг разбора JSON пропущен.
	пер рез4 = http.запросить(база + "/задачи")
	т.проверить(отчёт, не рез4.ошибка(), "T009: GET /задачи не упал транспортно")
	если не рез4.ошибка() тогда
		пер ответ4 = рез4.значение()
		т.равны(отчёт, ответ4.статус, 200, "T009: статус 200 на GET без тела")
	конец

	т.напечатать_сводку(отчёт)
	если отчёт.провалено > 0 тогда
		паника("test_приложение.pns: есть провалившиеся проверки")
	конец
конец
