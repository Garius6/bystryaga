// demo/заметки.pns — типы демо-сервиса "Заметки", отдельно от
// старт()/маршрутов (заметки_сервис.pns) — codegen.pns требует СВОЙ
// файл для аннотированных структур (сгенерированный заметки_gen.pns
// лежит рядом и импортирует этот файл как модуль).
//
// ТелоJSON/ОтветJSON/Валидируемое — руками, не codegen: codegen's
// &Json (переиспользованный из ../codegen) генерирует json.ИзJSON/
// json.ВJSON, а быстряга требует СВОИ ТелоJSON/ОтветJSON (см. doc-
// комментарий этих типов в ../валидация.pns) — разные типы с точки
// зрения тайпчекера, не взаимозаменяемы. &Схема (свой генератор
// быстряги) генерирует быстряга.ОписаниеСхемы напрямую — им и
// пользуемся здесь.

импорт "../быстряга.pns" как быстряга
импорт "кодирование/json" как json

// --- Тело запроса: создание заметки ---

&Схема
экспорт тип ЗаметкаВвод = структура
	заголовок: Строка
	текст:     Строка
конец

реализация быстряга.ТелоJSON для ЗаметкаВвод
	функ заполнить_из_json(это: ЗаметкаВвод, значение: json.Значение) -> Опция(Ошибка)
		пер поле_заголовка = значение.поле("заголовок")
		если поле_заголовка.пусто() тогда
			возврат Опция.Есть(Ошибка("json", "ожидалось поле 'заголовок'"))
		конец
		это.заголовок = поле_заголовка.получить(json.Значение.Ноль).как_строку().получить("")
		пер поле_текста = значение.поле("текст")
		это.текст = поле_текста.получить(json.Значение.Строка("")).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ЗаметкаВвод
	функ проверить(это: ЗаметкаВвод) -> Опция(Строка)
		если длина(это.заголовок) == 0 тогда
			возврат Опция.Есть("заголовок не может быть пустым")
		конец
		Опция.Нет()
	конец
конец

// --- Ответ: заметка ---

&Схема
экспорт тип Заметка = структура
	ид:        Число
	заголовок: Строка
	текст:     Строка
конец

реализация быстряга.ОтветJSON для Заметка
	функ в_json(это: Заметка) -> json.Значение
		json.объект(массив(
			("ид", json.Значение.Число(это.ид)),
			("заголовок", json.Значение.Строка(это.заголовок)),
			("текст", json.Значение.Строка(это.текст))
		))
	конец
конец

// GET /заметки возвращает СПИСОК — Массив(Заметка) сам по себе не
// реализует ОтветJSON (список не наследует интерфейс за своих
// элементов), поэтому оборачиваем в структуру со своей .в_json(),
// сериализующей элементы вручную. Этот файл — единственный список
// заметок, который "хранится": две демо-записи, не подключение к
// реальной БД.
экспорт тип СписокЗаметок = структура
	элементы: Массив(Заметка)
конец

реализация быстряга.ОтветJSON для СписокЗаметок
	функ в_json(это: СписокЗаметок) -> json.Значение
		пер элементы_json: Массив(json.Значение) = массив()
		для з в это.элементы цикл
			элементы_json.добавить(з.в_json())
		конец
		json.список(элементы_json)
	конец
конец
