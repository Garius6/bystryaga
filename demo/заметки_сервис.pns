// demo/заметки_сервис.pns — небольшой сервис "Заметки" на быстряге,
// показывает вместе типизированные обработчики с авто-валидацией/JSON,
// OpenAPI/Swagger, middleware и при_старте.
//
// Запуск:  panos demo/заметки_сервис.pns   (из корня репозитория —
// быстряга.pns резолвится как соседний файл, см. quickstart.md про
// разницу с импортом через pan-зависимость)
//
// Хранилище — намеренно ненастоящее (без top-level мутируемого
// состояния, panos допускает только конст на верхнем уровне): каждая
// созданная заметка получает "ид" из время.сейчас_мс(), запросы не
// делят между собой реальный список. Показывает форму API, не
// продакшн-хранилище — то же упрощение, что и в quickstart.md.

импорт "../быстряга.pns" как быстряга
импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт ввод_вывод
импорт время

// --- Тело запроса: создание заметки ---

тип ЗаметкаВвод = структура
	заголовок: Строка
	текст:     Строка
конец

реализация быстряга.ТелоJSON для ЗаметкаВвод
	функ заполнить_из_json(это: ЗаметкаВвод, значение: json.Значение) -> Опция(Ошибка)
		пер поле_заголовка = значение.поле("заголовок")
		если поле_заголовка.пусто() тогда
			возврат Опция.Есть(Ошибка("json", "ожидалось поле 'заголовок'"))
		конец
		это.заголовок = поле_заголовка.получить(json.Значение.Ноль).как_строку().получить("")
		пер поле_текста = значение.поле("текст")
		это.текст = поле_текста.получить(json.Значение.Строка("")).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ЗаметкаВвод
	функ проверить(это: ЗаметкаВвод) -> Опция(Строка)
		если длина(это.заголовок) == 0 тогда
			возврат Опция.Есть("заголовок не может быть пустым")
		конец
		Опция.Нет()
	конец
конец

// --- Ответ: заметка ---

тип Заметка = структура
	ид:        Число
	заголовок: Строка
	текст:     Строка
конец

реализация быстряга.ОтветJSON для Заметка
	функ в_json(это: Заметка) -> json.Значение
		json.объект(массив(
			("ид", json.Значение.Число(это.ид)),
			("заголовок", json.Значение.Строка(это.заголовок)),
			("текст", json.Значение.Строка(это.текст))
		))
	конец
конец

// GET /заметки возвращает СПИСОК — Массив(Заметка) сам по себе не
// реализует ОтветJSON (список не наследует интерфейс за своих
// элементов), поэтому оборачиваем в структуру со своей .в_json(),
// сериализующей элементы вручную. Этот файл — единственный список
// заметок, который "хранится": две демо-записи, не подключение к
// реальной БД.
тип СписокЗаметок = структура
	элементы: Массив(Заметка)
конец

реализация быстряга.ОтветJSON для СписокЗаметок
	функ в_json(это: СписокЗаметок) -> json.Значение
		пер элементы_json: Массив(json.Значение) = массив()
		для з в это.элементы цикл
			элементы_json.добавить(з.в_json())
		конец
		json.список(элементы_json)
	конец
конец

функ старт() -> Пусто
	пер апи = быстряга.приложение()

	// Логирующий middleware — метод+путь каждого запроса, до того как
	// известно, какой маршрут (если вообще какой-то) подойдёт.
	апи.middleware(функ(зпр: Запрос, дальше: быстряга.Далее) -> http.ОтветСервера
		ввод_вывод.печать(зпр.метод() + " " + зпр.путь())
		дальше(зпр)
	конец)

	апи.при_старте(функ() -> Пусто
		ввод_вывод.печать("заметки-сервис стартует на :8090")
	конец)

	апи.отправить_пост(
		"/заметки",
		функ() -> ЗаметкаВвод ЗаметкаВвод("", "") конец,
		функ(ввод: ЗаметкаВвод) -> быстряга.Отклик(Заметка)
			быстряга.Отклик(201.0, Заметка(время.сейчас_мс(), ввод.заголовок, ввод.текст))
		конец
	)

	апи.получить("/заметки", функ(зм: http.ЗапросМаршрута) -> СписокЗаметок
		СписокЗаметок(массив(
			Заметка(1.0, "Первая заметка", "демо-содержимое"),
			Заметка(2.0, "Вторая заметка", "ещё демо-содержимое")
		))
	конец)

	апи.удалить("/заметки", функ(зм: http.ЗапросМаршрута) -> Заметка
		Заметка(0.0, "удалено", "")
	конец)

	апи.маршрутизатор.получить("/openapi.json", быстряга.документация(апи))
	апи.маршрутизатор.получить("/docs", быстряга.swagger_ui())

	апи.запустить(8090.0, 1.0)
конец
