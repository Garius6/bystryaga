// demo/заметки_сервис.pns — небольшой сервис "Заметки" на быстряге,
// показывает вместе типизированные обработчики с авто-валидацией/JSON,
// OpenAPI/Swagger с детальной схемой (codegen &Схема), middleware и
// при_старте.
//
// Запуск:  panos demo/заметки_сервис.pns   (из корня репозитория —
// быстряга.pns резолвится как соседний файл, см. quickstart.md про
// разницу с импортом через pan-зависимость)
//
// Типы (ЗаметкаВвод/Заметка/СписокЗаметок) — demo/заметки.pns,
// поля_схемы() для них — demo/заметки_gen.pns (сгенерирован `panos
// codegen.pns demo/заметки.pns -o demo/заметки_gen.pns` из корня
// репозитория — не редактировать вручную, перегенерировать при
// изменении полей).
//
// Хранилище — намеренно ненастоящее (без top-level мутируемого
// состояния, panos допускает только конст на верхнем уровне): каждая
// созданная заметка получает "ид" из время.сейчас_мс(), запросы не
// делят между собой реальный список. Показывает форму API, не
// продакшн-хранилище — то же упрощение, что и в quickstart.md.

импорт "../быстряга.pns" как быстряга
импорт "сеть/http" как http
импорт "заметки.pns" как заметки
импорт "заметки_gen.pns" как _заметки_gen
импорт ввод_вывод
импорт время

функ старт() -> Пусто
	пер апи = быстряга.приложение()

	// Логирующий middleware — метод+путь каждого запроса, до того как
	// известно, какой маршрут (если вообще какой-то) подойдёт.
	апи.middleware(функ(зпр: Запрос, дальше: быстряга.Далее) -> http.ОтветСервера
		ввод_вывод.печать(зпр.метод() + " " + зпр.путь())
		дальше(зпр)
	конец)

	апи.при_старте(функ() -> Пусто
		ввод_вывод.печать("заметки-сервис стартует на :8090")
	конец)

	// _со_схемой — заголовок/текст, ид/заголовок/текст в /openapi.json
	// приходят из заметки_gen.pns's поля_схемы() (codegen &Схема), не
	// написаны руками.
	апи.отправить_пост_со_схемой(
		"/заметки",
		функ() -> заметки.ЗаметкаВвод заметки.ЗаметкаВвод("", "") конец,
		функ() -> заметки.Заметка заметки.Заметка(0.0, "", "") конец,
		функ(ввод: заметки.ЗаметкаВвод) -> быстряга.Отклик(заметки.Заметка)
			быстряга.Отклик(201, заметки.Заметка(время.сейчас_мс(), ввод.заголовок, ввод.текст))
		конец
	)

	апи.получить("/заметки", функ(зм: http.ЗапросМаршрута) -> заметки.СписокЗаметок
		заметки.СписокЗаметок(массив(
			заметки.Заметка(1.0, "Первая заметка", "демо-содержимое"),
			заметки.Заметка(2.0, "Вторая заметка", "ещё демо-содержимое")
		))
	конец)

	апи.удалить("/заметки", функ(зм: http.ЗапросМаршрута) -> заметки.Заметка
		заметки.Заметка(0.0, "удалено", "")
	конец)

	апи.маршрутизатор.получить("/openapi.json", быстряга.документация(апи))
	апи.маршрутизатор.получить("/docs", быстряга.swagger_ui())

	апи.запустить(8090, 1.0)
конец
