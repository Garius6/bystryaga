импорт "синтаксис" как синтаксис
импорт "строки" как строки

// &Схема generator для codegen.pns (этот же репозиторий) — генерирует
// реализацию быстряга.ОписаниеСхемы для аннотированной структуры: одно
// поля_схемы(), возвращающее плоский список быстряга.ПолеСхемы(имя,
// тип_json, обязательно), по одному на каждое поле структуры. Маппинг
// типов такой же грубый, как у codegen's &Json (примитивы + массив/
// объект), детальные вложенные схемы (объект внутри объекта) не
// строятся — тот же уровень детализации, что и весь остальной
// документация.pns.
//
// Живёт в этом репозитории (не в ../codegen) — путь импорта быстряги у
// каждого потребителя свой (глубина `модули/`), в отличие от
// std-модуля "кодирование/json", который codegen's &Json может
// импортировать по фиксированному пути из любого файла. Обнаруживается
// вживую: аннотированный файл уже импортирует быстрягу под алиасом
// "быстряга" (иначе он не смог бы сам реализовать ТелоJSON/ОтветJSON/
// Валидируемое) — синтаксис.импорты() находит эту же строку импорта и
// переиспользует её буквально (сгенерированный файл лежит РЯДОМ с
// исходным, та же директория, тот же относительный путь остаётся
// валиден — тот же приём, что codegen's генератор_json.pns использует
// для cross-file вложенных типов).

функ тип_json_для(тип_текст: Строка) -> Строка
	если строки.начинается_с(тип_текст, "Опция(") и строки.заканчивается_на(тип_текст, ")") тогда
		возврат тип_json_для(строки.срез(тип_текст, 6, длина(тип_текст) - 1))
	конец
	если тип_текст == "Число" или тип_текст == "Целое" тогда
		возврат "number"
	конец
	если тип_текст == "Строка" тогда
		возврат "string"
	конец
	если тип_текст == "Булево" тогда
		возврат "boolean"
	конец
	если строки.начинается_с(тип_текст, "Массив(") тогда
		возврат "array"
	конец
	"object"
конец

// Опция(X) — необязательное поле; всё остальное, включая примитивы и
// вложенные структуры, — обязательное. Тот же грубый эвристический
// уровень, что весь остальной документация.pns.
функ обязательно_для(тип_текст: Строка) -> Булево
	не строки.начинается_с(тип_текст, "Опция(")
конец

функ найти_путь_быстряги(путь: Строка) -> Результат(Строка, Ошибка)
	пер импорты_рез = синтаксис.импорты(путь)
	если импорты_рез.ошибка() тогда
		возврат Результат.Неудача(импорты_рез.причина())
	конец
	для пара в импорты_рез.значение() цикл
		если пара.0 == "быстряга" тогда
			возврат Результат.Успех(пара.1)
		конец
	конец
	Результат.Неудача(Ошибка("быстряга_схема_gen", "\(путь): аннотация &Схема требует импорт быстряги под алиасом 'быстряга' в этом же файле"))
конец

/// Генератор для &Схема — та же сигнатура, что и codegen's генератор_json.
/// генерировать (путь, имя_типа, алиас_источника) -> Результат(Строка,
/// Ошибка), чтобы codegen.pns мог зарегистрировать оба под одним
/// интерфейсом.
экспорт функ генерировать(путь: Строка, имя_типа: Строка, алиас_источника: Строка) -> Результат(Строка, Ошибка)
	пер путь_быстряги_рез = найти_путь_быстряги(путь)
	если путь_быстряги_рез.ошибка() тогда
		возврат Результат.Неудача(путь_быстряги_рез.причина())
	конец

	пер поля = синтаксис.поля(путь, имя_типа).ожидать("синтаксис.поля не удался")
	пер квалифицированное_имя = "\(алиас_источника).\(имя_типа)"

	пер тело = "импорт \"\(путь_быстряги_рез.значение())\" как быстряга\n\n"
	тело = "\(тело)реализация быстряга.ОписаниеСхемы для \(квалифицированное_имя)\n"
	тело = "\(тело)\tфунк поля_схемы(это: \(квалифицированное_имя)) -> Массив(быстряга.ПолеСхемы)\n"
	тело = "\(тело)\t\tмассив(\n"
	для поле в поля цикл
		пер тип_json = тип_json_для(поле.1)
		пер обяз = если обязательно_для(поле.1) тогда "истина" иначе "ложь" конец
		тело = "\(тело)\t\t\tбыстряга.ПолеСхемы(\"\(поле.0)\", \"\(тип_json)\", \(обяз)),\n"
	конец
	тело = "\(тело)\t\t)\n\tконец\nконец\n"
	Результат.Успех(тело)
конец
