// test_посредник.pns — US3 e2e-тесты: реальный сокет, тот же принцип,
// что test_приложение.pns/test_документация.pns. Порядок вызова
// посредников проверяется КОСВЕННО через тело ответа (каждое звено
// дописывает свой префикс перед телом, полученным от Далее) — не
// через общий счётчик: посредник работает ВНУТРИ запусти-спавненного
// серверного процесса, недоступного обратно вызывающему тесту.

импорт быстряга
импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт "тест" как т
импорт время
импорт строки
импорт ос
импорт фс

конст ПОРТ_ПОРЯДОК = 18082
конст ПОРТ_ЗАМОК = 18083
конст МЕТКА = "/tmp/быстряга_тест_старта.marker"

тип Задача = структура
	ид: Число
конец

реализация быстряга.ОтветJSON для Задача
	функ в_json(это: Задача) -> json.Значение
		json.объект(массив(("ид", json.Значение.Число(это.ид))))
	конец
конец

// T030/T032: два посредника (M1 -> M2 -> H) + при_старте-хук — сервер
// на ПОРТ_ПОРЯДОК.
функ запустить_сервер_порядок() -> Пусто
	пер апи = быстряга.приложение()
	апи.при_старте(функ() -> Пусто
		ос.выполнить("sh", массив("-c", "echo старт >> " + МЕТКА), "/tmp")
	конец)
	апи.посредник(функ(зпр: Запрос, дальше: быстряга.Далее) -> http.ОтветСервера
		пер отклик = дальше(зпр)
		http.ОтветСервера(отклик.статус, отклик.тип_содержимого, "M1:" + отклик.тело)
	конец)
	апи.посредник(функ(зпр: Запрос, дальше: быстряга.Далее) -> http.ОтветСервера
		пер отклик = дальше(зпр)
		http.ОтветСервера(отклик.статус, отклик.тип_содержимого, "M2:" + отклик.тело)
	конец)
	апи.получить("/задачи", функ(зм: http.ЗапросМаршрута) -> Задача
		Задача(1.0)
	конец)
	апи.запустить(ПОРТ_ПОРЯДОК, 1.0)
конец

// T031: посредник, не вызывающий Далее — короткое замыкание — сервер
// на ПОРТ_ЗАМОК.
функ запустить_сервер_замок() -> Пусто
	пер апи = быстряга.приложение()
	апи.посредник(функ(зпр: Запрос, дальше: быстряга.Далее) -> http.ОтветСервера
		http.ОтветСервера(403, "text/plain", "заблокировано посредником")
	конец)
	апи.получить("/задачи", функ(зм: http.ЗапросМаршрута) -> Задача
		Задача(1.0)
	конец)
	апи.запустить(ПОРТ_ЗАМОК, 1.0)
конец

функ старт() -> Пусто
	пер отчёт = т.новый_отчёт()
	ос.выполнить("sh", массив("-c", "rm -f " + МЕТКА), "/tmp")
	запусти запустить_сервер_порядок()
	запусти запустить_сервер_замок()
	время.спать_мс(200.0)

	// T032: при_старте-хук вызван до первого запроса — маркер-файл
	// уже существует к этому моменту (хук выполняется синхронно ДО
	// http.обслуживать внутри .запустить(), задолго до времени сна
	// выше).
	пер маркер = фс.прочитать(МЕТКА)
	т.проверить(отчёт, не маркер.ошибка(), "T032: при_старте-хук создал маркер-файл до первого запроса")

	// T030: M1 -> M2 -> H — тело ответа "M1:M2:{...}" (M1 — самый
	// внешний, дописывает свой префикс ПОСЛЕДНИМ поверх уже
	// префиксированного M2-результата).
	пер рез1 = http.запросить("http://127.0.0.1:" + строки.из_целого(ПОРТ_ПОРЯДОК) + "/задачи")
	т.проверить(отчёт, не рез1.ошибка(), "T030: GET /задачи (цепочка посредников) не упал транспортно")
	если не рез1.ошибка() тогда
		пер ответ1 = рез1.значение()
		т.равны(отчёт, ответ1.статус, 200, "T030: статус 200 сквозь всю цепочку")
		т.проверить(отчёт, строки.начинается_с(ответ1.тело, "M1:M2:"), "T030: порядок вызова M1 -> M2 -> обработчик (префиксы в теле)")
	конец

	// T031: посредник не вызывает Далее — обработчик не вызван,
	// клиент получает 403 от самого посредника, не JSON-тело Задачи.
	пер рез2 = http.запросить("http://127.0.0.1:" + строки.из_целого(ПОРТ_ЗАМОК) + "/задачи")
	т.проверить(отчёт, не рез2.ошибка(), "T031: GET /задачи (замкнутая цепочка) не упал транспортно")
	если не рез2.ошибка() тогда
		пер ответ2 = рез2.значение()
		т.равны(отчёт, ответ2.статус, 403, "T031: статус 403 от посредника, не 200 от обработчика")
		т.проверить(отчёт, не строки.содержит(ответ2.тело, "ид"), "T031: тело — НЕ сериализованная Задача (обработчик не вызван)")
	конец

	т.напечатать_сводку(отчёт)
	если отчёт.провалено > 0 тогда
		паника("test_посредник.pns: есть провалившиеся проверки")
	конец
конец
