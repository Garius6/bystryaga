// test_документация.pns — US2 e2e-тесты: реальный сокет (сервер в
// запусти-процессе + сеть.http_запрос с клиентской стороны того же
// теста), тот же принцип, что test_приложение.pns.

импорт быстряга
импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт "тест" как т
импорт время
импорт строки

конст ПОРТ = 18081

тип Задача = структура
	ид:   Число
	текст: Строка
конец

реализация быстряга.ОтветJSON для Задача
	функ в_json(это: Задача) -> json.Значение
		json.объект(массив(
			("ид", json.Значение.Число(это.ид)),
			("текст", json.Значение.Строка(это.текст))
		))
	конец
конец

тип ЗаметкаВвод = структура
	заголовок: Строка
конец

реализация быстряга.ТелоJSON для ЗаметкаВвод
	функ заполнить_из_json(это: ЗаметкаВвод, значение: json.Значение) -> Опция(Ошибка)
		это.заголовок = значение.поле("заголовок").получить(json.Значение.Ноль).как_строку().получить("")
		Опция.Нет()
	конец
конец

реализация быстряга.Валидируемое для ЗаметкаВвод
	функ проверить(это: ЗаметкаВвод) -> Опция(Строка)
		Опция.Нет()
	конец
конец

реализация быстряга.ОписаниеСхемы для ЗаметкаВвод
	функ поля_схемы(это: ЗаметкаВвод) -> Массив(быстряга.ПолеСхемы)
		массив(быстряга.ПолеСхемы("заголовок", "string", истина))
	конец
конец

реализация быстряга.ОписаниеСхемы для Задача
	функ поля_схемы(это: Задача) -> Массив(быстряга.ПолеСхемы)
		массив(
			быстряга.ПолеСхемы("ид", "number", истина),
			быстряга.ПолеСхемы("текст", "string", истина)
		)
	конец
конец

функ запустить_сервер() -> Пусто
	пер апи = быстряга.приложение()
	апи.получить("/задачи", функ(зм: http.ЗапросМаршрута) -> Задача
		Задача(1.0, "пример")
	конец)
	апи.удалить("/задачи", функ(зм: http.ЗапросМаршрута) -> Задача
		Задача(1.0, "пример")
	конец)
	апи.отправить_пост_со_схемой(
		"/заметки",
		функ() -> ЗаметкаВвод ЗаметкаВвод("") конец,
		функ() -> Задача Задача(0.0, "") конец,
		функ(ввод: ЗаметкаВвод) -> быстряга.Отклик(Задача)
			быстряга.Отклик(201, Задача(1.0, ввод.заголовок))
		конец
	)
	апи.маршрутизатор.получить("/openapi.json", быстряга.документация(апи))
	апи.маршрутизатор.получить("/docs", быстряга.swagger_ui())
	апи.запустить(ПОРТ, 1.0)
конец

функ старт() -> Пусто
	пер отчёт = т.новый_отчёт()
	запусти запустить_сервер()
	время.спать_мс(200.0)

	пер база = "http://127.0.0.1:" + строки.из_целого(ПОРТ)

	// T021 / Acceptance Scenario: GET /openapi.json на приложении с
	// ≥2 маршрутами (получить + удалить, оба на /задачи) — валидный
	// JSON, содержит путь с обоими методами (SC-004).
	пер рез1 = http.запросить(база + "/openapi.json")
	т.проверить(отчёт, не рез1.ошибка(), "T021: GET /openapi.json не упал транспортно")
	если не рез1.ошибка() тогда
		пер ответ1 = рез1.значение()
		т.равны(отчёт, ответ1.статус, 200, "T021: статус 200")
		пер тело1 = json.разобрать(ответ1.тело)
		т.проверить(отчёт, не тело1.ошибка(), "T021: тело — валидный JSON")
		если не тело1.ошибка() тогда
			пер маршрут = тело1.значение().поле("paths").получить(json.Значение.Ноль).поле("/задачи")
			т.проверить(отчёт, маршрут.есть(), "T021: /openapi.json содержит путь /задачи")
			если маршрут.есть() тогда
				пер методы = маршрут.получить(json.Значение.Ноль)
				т.проверить(отчёт, методы.поле("get").есть(), "T021: путь /задачи содержит метод GET")
				т.проверить(отчёт, методы.поле("delete").есть(), "T021: путь /задачи содержит метод DELETE")
			конец

			// Acceptance Scenario: маршрут с ОписаниеСхемы содержит
			// развёрнутую JSON Schema тела запроса и ответа.
			пер маршрут_со_схемой = тело1.значение().поле("paths").получить(json.Значение.Ноль).поле("/заметки")
			т.проверить(отчёт, маршрут_со_схемой.есть(), "T023: /openapi.json содержит путь /заметки")
			если маршрут_со_схемой.есть() тогда
				пер пост = маршрут_со_схемой.получить(json.Значение.Ноль).поле("post")
				т.проверить(отчёт, пост.есть(), "T023: путь /заметки содержит метод POST")
				если пост.есть() тогда
					пер операция = пост.получить(json.Значение.Ноль)
					пер тело_запроса = операция.поле("requestBody").получить(json.Значение.Ноль).поле("content").получить(json.Значение.Ноль).поле("application/json").получить(json.Значение.Ноль).поле("schema").получить(json.Значение.Ноль).поле("properties").получить(json.Значение.Ноль)
					т.проверить(отчёт, тело_запроса.поле("заголовок").есть(), "T023: requestBody содержит схему поля 'заголовок'")

					пер тело_ответа = операция.поле("responses").получить(json.Значение.Ноль).поле("200").получить(json.Значение.Ноль).поле("content").получить(json.Значение.Ноль).поле("application/json").получить(json.Значение.Ноль).поле("schema").получить(json.Значение.Ноль).поле("properties").получить(json.Значение.Ноль)
					т.проверить(отчёт, тело_ответа.поле("ид").есть(), "T023: тело 200-ответа содержит схему поля 'ид'")
				конец
			конец
		конец
	конец

	// T022 / Acceptance Scenario: GET /docs — валидный HTML со ссылкой
	// на /openapi.json и CDN-скриптом Swagger UI.
	пер рез2 = http.запросить(база + "/docs")
	т.проверить(отчёт, не рез2.ошибка(), "T022: GET /docs не упал транспортно")
	если не рез2.ошибка() тогда
		пер ответ2 = рез2.значение()
		т.равны(отчёт, ответ2.статус, 200, "T022: статус 200")
		т.проверить(отчёт, строки.содержит(ответ2.тело, "/openapi.json"), "T022: HTML ссылается на /openapi.json")
		т.проверить(отчёт, строки.содержит(ответ2.тело, "swagger-ui"), "T022: HTML тянет Swagger UI CDN-скрипт")
	конец

	т.напечатать_сводку(отчёт)
	если отчёт.провалено > 0 тогда
		паника("test_документация.pns: есть провалившиеся проверки")
	конец
конец
