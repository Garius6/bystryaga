// test_авторизация.pns — US4 e2e-тесты: реальный сокет, тот же принцип,
// что test_приложение.pns/test_посредник.pns. jwt_посредник
// проверяется через реальный HTTP-запрос с заголовком Authorization —
// валидный/просроченный/подписанный другим секретом/отсутствующий
// токен.

импорт быстряга
импорт "сеть/http" как http
импорт "кодирование/jwt" как jwt
импорт "кодирование/json" как json
импорт "тест" как т
импорт время
импорт строки

конст ПОРТ = 18084
конст СЕКРЕТ = "тестовый-секрет"

тип Задача = структура
	ид: Число
конец

реализация быстряга.ОтветJSON для Задача
	функ в_json(это: Задача) -> json.Значение
		json.объект(массив(("ид", json.Значение.Число(это.ид))))
	конец
конец

функ запустить_сервер() -> Пусто
	пер апи = быстряга.приложение()
	апи.посредник(быстряга.jwt_посредник(СЕКРЕТ))
	апи.получить("/защищено", функ(зм: http.ЗапросМаршрута) -> Задача
		Задача(1.0)
	конец)
	апи.запустить(ПОРТ, 1.0)
конец

функ токен_с_истечением(секунды_от_сейчас: Число) -> Строка
	jwt.создать(СЕКРЕТ, json.объект(массив(
		("sub", json.Значение.Строка("пользователь")),
		("exp", json.Значение.Число(время.сейчас_мс() / 1000.0 + секунды_от_сейчас))
	)))
конец

функ старт() -> Пусто
	пер отчёт = т.новый_отчёт()
	запусти запустить_сервер()
	время.спать_мс(200.0)

	пер база = "http://127.0.0.1:" + строки.из_целого(ПОРТ) + "/защищено"

	// T040: без заголовка Authorization — 401, обработчик не вызван.
	пер рез1 = http.запросить(база)
	т.проверить(отчёт, не рез1.ошибка(), "T040: GET без Authorization не упал транспортно")
	если не рез1.ошибка() тогда
		т.равны(отчёт, рез1.значение().статус, 401, "T040: статус 401 без Authorization")
	конец

	// T041: валидный токен — 200, обработчик вызван.
	пер валидный = токен_с_истечением(3600.0)
	пер рез2 = http.получить_с_заголовками(база, соответствие("Authorization" = "Bearer " + валидный))
	т.проверить(отчёт, не рез2.ошибка(), "T041: GET с валидным токеном не упал транспортно")
	если не рез2.ошибка() тогда
		т.равны(отчёт, рез2.значение().статус, 200, "T041: статус 200 с валидным токеном")
		т.проверить(отчёт, строки.содержит(рез2.значение().тело, "ид"), "T041: тело — сериализованная Задача (обработчик вызван)")
	конец

	// T042: просроченный токен — 401.
	пер просроченный = токен_с_истечением(-10.0)
	пер рез3 = http.получить_с_заголовками(база, соответствие("Authorization" = "Bearer " + просроченный))
	т.проверить(отчёт, не рез3.ошибка(), "T042: GET с просроченным токеном не упал транспортно")
	если не рез3.ошибка() тогда
		т.равны(отчёт, рез3.значение().статус, 401, "T042: статус 401 с просроченным токеном")
	конец

	// T043: токен, подписанный другим секретом — 401.
	пер чужой = jwt.создать("другой-секрет", json.объект(массив(("sub", json.Значение.Строка("злоумышленник")))))
	пер рез4 = http.получить_с_заголовками(база, соответствие("Authorization" = "Bearer " + чужой))
	т.проверить(отчёт, не рез4.ошибка(), "T043: GET с чужой подписью не упал транспортно")
	если не рез4.ошибка() тогда
		т.равны(отчёт, рез4.значение().статус, 401, "T043: статус 401 с чужой подписью")
	конец

	// T044: заголовок Authorization без "Bearer " — 401.
	пер рез5 = http.получить_с_заголовками(база, соответствие("Authorization" = валидный))
	т.проверить(отчёт, не рез5.ошибка(), "T044: GET с сырым токеном без 'Bearer ' не упал транспортно")
	если не рез5.ошибка() тогда
		т.равны(отчёт, рез5.значение().статус, 401, "T044: статус 401 без префикса 'Bearer '")
	конец

	т.напечатать_сводку(отчёт)
	если отчёт.провалено > 0 тогда
		паника("test_авторизация.pns: есть провалившиеся проверки")
	конец
конец
