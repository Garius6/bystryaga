// приложение.pns — Приложение (типизированная надстройка над
// http.Маршрутизатор), Отклик(О), middleware/lifecycle-хуки. Часть
// быстряги (../быстряга.pns реэкспортирует этот файл целиком).

импорт "сеть/http" как http
импорт "кодирование/json" как json
импорт "валидация.pns" как валидация

/// Оборачивает тело ответа явным HTTP-статусом — обработчики
/// типизированных маршрутов ВСЕГДА возвращают Отклик(О), не голый О
/// (panos статически типизирован, у функции один тип возврата).
экспорт тип Отклик[О] = структура
	статус: Число
	тело:   О
конец

/// Отклик(О) со статусом 200 — сокращение для самого частого случая.
экспорт функ ок[О](тело: О) -> Отклик(О)
	Отклик(200.0, тело)
конец

/// Метаданные одного зарегистрированного маршрута — источник для
/// документация.pns. Без детальной JSON Schema тела/ответа: путь+метод
/// есть всегда, схемы нет.
экспорт тип МетаданныеМаршрута = структура
	метод: Строка
	путь:  Строка
конец

// Далее/Middleware работают на низкоуровневом Запрос (не
// http.ЗапросМаршрута) — middleware оборачивает ВЕСЬ конвейер
// обработки, ВКЛЮЧАЯ сопоставление маршрута (см. http.Маршрутизатор.
// обработать(это, запрос: Запрос) -> ОтветСервера — именно эта
// сигнатура оборачивается в .запустить() ниже), а не только уже
// сматченный конкретный маршрут. Middleware вроде проверки
// авторизации по заголовку должен уметь коротко замкнуть запрос ДО
// того, как вообще известно, какой маршрут подошёл бы.

/// Продолжение цепочки middleware — вызовите, чтобы передать запрос
/// дальше (следующему middleware или, для последнего звена, самому
/// Маршрутизатору). НЕ вызывайте, чтобы коротко замкнуть цепочку
/// (например при отказе авторизации) — тогда middleware сам
/// формирует ОтветСервера.
экспорт тип Далее = функ(Запрос) -> http.ОтветСервера

экспорт тип Middleware = функ(Запрос, Далее) -> http.ОтветСервера

/// Типизированная надстройка над http.Маршрутизатор — регистрируйте
/// маршруты методами получить/отправить_пост/..., затем .запустить(порт).
экспорт тип Приложение = структура
	маршрутизатор:      http.Маршрутизатор
	маршруты_докс:      Массив(МетаданныеМаршрута)
	middleware_список:  Массив(Middleware)
	хуки_старта:        Массив(функ() -> Пусто)
	хуки_остановки:     Массив(функ() -> Пусто)
конец

/// Создаёт пустое Приложение.
экспорт функ приложение() -> Приложение
	Приложение(http.маршрутизатор(), массив(), массив(), массив(), массив())
конец

реализация Приложение
	/// Регистрирует обработчик GET-запросов без тела — Ответ должен
	/// реализовывать валидация.ОтветJSON, сериализуется автоматически.
	функ получить[Ответ: валидация.ОтветJSON](это: Приложение, путь: Строка, обработчик: функ(http.ЗапросМаршрута) -> Ответ) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("GET", путь))
		это.маршрутизатор.получить(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			http.ОтветСервера(200.0, "application/json", json.сериализовать(обработчик(зм).в_json()))
		конец)
	конец

	/// Регистрирует обработчик DELETE-запросов без тела — симметрично получить.
	функ удалить[Ответ: валидация.ОтветJSON](это: Приложение, путь: Строка, обработчик: функ(http.ЗапросМаршрута) -> Ответ) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("DELETE", путь))
		это.маршрутизатор.удалить(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			http.ОтветСервера(200.0, "application/json", json.сериализовать(обработчик(зм).в_json()))
		конец)
	конец

	/// Регистрирует обработчик POST-запросов с типизированным телом —
	/// разбирает JSON в Тело (нулевое_тело — фабрика пустого инстанса,
	/// panos не умеет сконструировать generic-параметр "из ничего"),
	/// валидирует через Тело.проверить(), сериализует Отклик(Ответ) в
	/// JSON-ответ.
	функ отправить_пост[Тело: валидация.ТелоJSON + валидация.Валидируемое, Ответ: валидация.ОтветJSON](
		это: Приложение,
		путь: Строка,
		нулевое_тело: функ() -> Тело,
		обработчик: функ(Тело) -> Отклик(Ответ)
	) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("POST", путь))
		это.маршрутизатор.отправить_пост(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			обработать_тело(зм, нулевое_тело, обработчик)
		конец)
	конец

	/// Регистрирует обработчик PUT-запросов с типизированным телом — симметрично отправить_пост.
	функ отправить_put[Тело: валидация.ТелоJSON + валидация.Валидируемое, Ответ: валидация.ОтветJSON](
		это: Приложение,
		путь: Строка,
		нулевое_тело: функ() -> Тело,
		обработчик: функ(Тело) -> Отклик(Ответ)
	) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("PUT", путь))
		это.маршрутизатор.отправить_put(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			обработать_тело(зм, нулевое_тело, обработчик)
		конец)
	конец

	/// Регистрирует обработчик PATCH-запросов с типизированным телом — симметрично отправить_пост.
	функ отправить_patch[Тело: валидация.ТелоJSON + валидация.Валидируемое, Ответ: валидация.ОтветJSON](
		это: Приложение,
		путь: Строка,
		нулевое_тело: функ() -> Тело,
		обработчик: функ(Тело) -> Отклик(Ответ)
	) -> Пусто
		это.маршруты_докс.добавить(МетаданныеМаршрута("PATCH", путь))
		это.маршрутизатор.отправить_patch(путь, функ(зм: http.ЗапросМаршрута) -> http.ОтветСервера
			обработать_тело(зм, нулевое_тело, обработчик)
		конец)
	конец

	/// Регистрирует middleware — вызывается в порядке РЕГИСТРАЦИИ
	/// (первый зарегистрированный вызывается первым при каждом
	/// запросе, оборачивает все последующие).
	функ middleware(это: Приложение, м: Middleware) -> Пусто
		это.middleware_список.добавить(м)
	конец

	/// Регистрирует хук, вызываемый РОВНО один раз перед первым
	/// принятым запросом (до http.обслуживать внутри .запустить()).
	функ при_старте(это: Приложение, ф: функ() -> Пусто) -> Пусто
		это.хуки_старта.добавить(ф)
	конец

	/// Регистрирует хук, вызываемый после остановки сервера — на
	/// практике сегодня недостижим для нормального пути: http.
	/// обслуживать блокирующий и не возвращается при успехе (см. его
	/// doc-комментарий), так что хуки_остановки срабатывают только
	/// если .запустить() вернулась с ошибкой бинда порта (см. ниже).
	функ при_остановке(это: Приложение, ф: функ() -> Пусто) -> Пусто
		это.хуки_остановки.добавить(ф)
	конец

	/// Слушает порт и обслуживает запросы (см. http.обслуживать).
	/// Строит финальную цепочку сворачиванием middleware_список СПРАВА
	/// НАЛЕВО вокруг это.маршрутизатор.обработать — при вызове порядок
	/// РЕАЛЬНЫХ вызовов получается M1 -> M2 -> ... -> Маршрутизатор
	/// (первый зарегистрированный — самый внешний). хуки_старта
	/// вызываются ДО http.обслуживать; хуки_остановки — ПОСЛЕ (см.
	/// doc-комментарий .при_остановке про сегодняшнее ограничение —
	/// блокирующий http.обслуживать делает "после" недостижимым на
	/// успешном пути).
	функ запустить(это: Приложение, порт: Число, процессов: Число) -> Результат(Число, Ошибка)
		для хук в это.хуки_старта цикл
			хук()
		конец

		пер маршрутизатор = это.маршрутизатор
		пер финальный = функ(зпр: Запрос) -> http.ОтветСервера
			маршрутизатор.обработать(зпр)
		конец

		// Лямбда-литерал, не именованная функция-ссылка — запасное
		// значение здесь недостижимо на практике (i всегда в границах).
		пер i: Целое = это.middleware_список.длина() - 1
		пока i >= 0 цикл
			пер текущий = это.middleware_список.получить(i, функ(зпр: Запрос, дальше: Далее) -> http.ОтветСервера дальше(зпр) конец)
			пер следующий = финальный
			финальный = функ(зпр: Запрос) -> http.ОтветСервера
				текущий(зпр, следующий)
			конец
			i = i - 1
		конец

		пер результат = http.обслуживать(порт, финальный, процессов)

		для хук в это.хуки_остановки цикл
			хук()
		конец
		результат
	конец
конец

// Общее тело POST/PUT/PATCH-обёртки — разбор JSON, валидация,
// сериализация ответа. Свободная generic-функция, а не метод: тут
// Тело/Ответ выводятся из аргументов вызывающих методов
// (нулевое_тело/обработчик) одинаково в обоих случаях, так что
// дублировать тело функции в отправить_пост/put/patch незачем.
функ обработать_тело[Тело: валидация.ТелоJSON + валидация.Валидируемое, Ответ: валидация.ОтветJSON](
	зм: http.ЗапросМаршрута,
	нулевое_тело: функ() -> Тело,
	обработчик: функ(Тело) -> Отклик(Ответ)
) -> http.ОтветСервера
	пер тело = нулевое_тело()
	пер результат_разбора = json.разобрать(зм.запрос.тело())
	если результат_разбора.ошибка() тогда
		возврат валидация.ответ_ошибки(400.0, результат_разбора.причина().сообщение)
	конец
	пер ошибка_заполнения = тело.заполнить_из_json(результат_разбора.значение())
	если ошибка_заполнения.есть() тогда
		возврат валидация.ответ_ошибки(400.0, ошибка_заполнения.получить(Ошибка("json", "")).сообщение)
	конец
	пер ошибка_валид = тело.проверить()
	если ошибка_валид.есть() тогда
		возврат валидация.ответ_ошибки(422.0, ошибка_валид.получить(""))
	конец
	пер отклик = обработчик(тело)
	http.ОтветСервера(отклик.статус, "application/json", json.сериализовать(отклик.тело.в_json()))
конец
